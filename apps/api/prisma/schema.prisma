// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  employees   Employee[]
  projects    Project[]
  assignments Assignment[]

  @@map("organizations")
}

model Employee {
  id                  Int          @id @default(autoincrement())
  organizationId      Int          @map("organization_id")
  name                String
  role                String
  weeklyCapacityHours Decimal      @map("weekly_capacity_hours") @db.Decimal(5, 2)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments         Assignment[]

  @@unique([organizationId, id], map: "employees_org_id_unique")
  @@map("employees")
}

model Project {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  name           String
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    Assignment[]

  @@unique([organizationId, id], map: "projects_org_id_unique")
  @@map("projects")
}

model Assignment {
  id                    Int      @id @default(autoincrement())
  organizationId        Int      @map("organization_id")
  employeeId            Int      @map("employee_id")
  projectId             Int      @map("project_id")
  startDate             DateTime @map("start_date") @db.Date
  endDate               DateTime @map("end_date") @db.Date
  allocatedHoursPerWeek Decimal  @map("allocated_hours_per_week") @db.Decimal(5, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId], map: "assignments_org_employee_idx")
  @@index([organizationId, projectId], map: "assignments_org_project_idx")
  @@map("assignments")
}
